<%- include('../partials/nav') %>
  </head>

  <style>
    * {
      box-sizing: border-box;
    }
    .site-page {
  margin: 0;
  padding: 0;
  min-height: 100vh;
  font-family: "Poppins", sans-serif;
  background: #f7f7f7;
  color: #222;
}

.site-head {
  display: block;
}

.charset-meta,
.viewport-meta {
  display: block;
}

.page-title {
  font-family: "Poppins", sans-serif;
}

.google-fonts {
  display: none;
}
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  padding: 14px 32px;
  background-color: #1f2937;
  color: #ffffff;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  position: sticky;
  top: 0;
  z-index: 100;
}
 
/* ===== Logo ===== */
.navbar__logo {
  font-size: 24px;
  font-weight: 700;
  letter-spacing: 0.5px;
  color: #fbbf24;
}
 
/* ===== Links list ===== */
.navbar__links {
  display: flex;
  align-items: center;
  gap: 24px;
  list-style: none;
  margin: 0;
  padding: 0;
}
 
.navbar__item {
  margin: 0;
}
 
/* ===== Single link ===== */
.navbar__link {
  color: #e5e7eb;
  text-decoration: none;
  font-size: 16px;
  font-weight: 500;
  padding: 6px 4px;
  border-bottom: 2px solid transparent;
  transition: color 0.2s ease, border-color 0.2s ease;
}
 
.navbar__link:hover,
.navbar__link:focus {
  color: #fbbf24;
  border-bottom-color: #fbbf24;
}
 
/* ===== Mobile ===== */
@media (max-width: 640px) {
  .navbar {
    flex-direction: column;
    align-items: flex-start;
    padding: 12px 16px;
  }
 
  .navbar__links {
    flex-wrap: wrap;
    gap: 12px 16px;
  }
}
 
    body {
      margin: 0;
      background: #f7f7f7;
      color: #222;
      font-family: Arial, Helvetica, sans-serif;
    }

    .homes-page {
      width: min(1200px, 92%);
      margin: 40px auto;
      padding: 35px;
      background: #fff;
      border-radius: 20px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    }

    .page-title {
      margin: 0 0 30px;
      text-align: center;
      color: #ff385c;
      font-size: 32px;
      font-weight: 700;
    }

    .homes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
      gap: 26px;
    }

    .home-card {
      overflow: hidden;
      background: #fff;
      border: 1px solid #eee;
      border-radius: 16px;
      box-shadow: 0 5px 18px rgba(0, 0, 0, 0.08);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .home-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 14px 28px rgba(0, 0, 0, 0.14);
    }

    .home-image {
      display: block;
      width: 100%;
      height: 210px;
      object-fit: cover;
    }

    .home-content {
      padding: 20px;
    }

    .home-name {
      margin: 0 0 10px;
      color: #222;
      font-size: 21px;
      font-weight: 700;
    }

    .home-location {
      margin: 0 0 16px;
      color: #666;
      font-size: 15px;
    }

    .home-info {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 18px;
    }

    .home-price {
      color: #ff385c;
      font-size: 18px;
      font-weight: 700;
    }

    .home-rating {
      padding: 5px 9px;
      background: #f7f7f7;
      border-radius: 8px;
      color: #444;
      font-size: 14px;
      font-weight: 600;
    }

    .details-btn {
      display: inline-block;
      width: 100%;
      padding: 11px 18px;
      border-radius: 9px;
      background: #ff385c;
      color: #fff;
      font-size: 15px;
      font-weight: 600;
      text-align: center;
      text-decoration: none;
      transition: background 0.2s ease, transform 0.2s ease;
    }

    .details-btn:hover {
      background: #e31c3d;
      transform: translateY(-1px);
    }

    @media (max-width: 600px) {
      .homes-page {
        width: 94%;
        margin: 20px auto;
        padding: 20px 15px;
      }

      .page-title {
        font-size: 25px;
      }

      .homes-grid {
        grid-template-columns: 1fr;
      }

      .home-image {
        height: 220px;
      }
    }
  </style>

  <body>
    <%- include('../partials/Header') %>

    <main class="homes-page">
      <h2 class="page-title">
        Welcome to Airbnb
      </h2>

      <div class="homes-grid">
        <% registeredHomes.forEach(home => { %>

          <div class="home-card">
            <img
              src="<%= home.photo %>"
              alt="<%= home.houseName %>"
              class="home-image"
            >

            <div class="home-content">
              <h3 class="home-name"><%= home.houseName %></h3>

              <p class="home-location">
                <i class="fas fa-map-marker-alt"></i>
                <%= home.location %>
              </p>

              <div class="home-info">
                <span class="home-price">
                  Rs <%= home.price %> / night
                </span>

                <span class="home-rating">
                  ⭐ <%= home.rating %>
                </span>
              </div>

              <%- include('../partials/fav', {home}) %>

              <a href="/<%= home.id %>" class="details-btn">
                View Details
              </a>
            </div>
          </div>

        <% }) %>
      </div>
    </main>
  </body>
</html>
