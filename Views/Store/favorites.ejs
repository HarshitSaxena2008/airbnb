<%- include('../partials/nav') %>
  </head><style>
  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: #f7f7f7;
    color: #222;
    font-family: Arial, Helvetica, sans-serif;
  }

  .home-page {
    width: min(1100px, 92%);
    margin: 40px auto;
    padding: 35px;
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 8px 28px rgba(0,0,0,.08);
  }

  .home-card {
    width: min(100%, 430px);
    margin: 0 auto;
    overflow: hidden;
    background: #fff;
    border: 1px solid #eee;
    border-radius: 18px;
    box-shadow: 0 6px 20px rgba(0,0,0,.09);
    transition: .25s ease;
  }

  .home-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 14px 30px rgba(0,0,0,.14);
  }

  .home-image {
    display: block;
    width: 100%;
    height: 260px;
    object-fit: cover;
  }

  .home-content { padding: 22px; }

  .home-name {
    margin: 0 0 10px;
    color: #222;
    font-size: 23px;
    font-weight: 700;
  }

  .home-location {
    margin: 0 0 18px;
    color: #666;
    font-size: 15px;
  }

  .home-details {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 18px;
  }

  .home-price {
    color: #ff385c;
    font-size: 19px;
    font-weight: 700;
  }

  .home-rating {
    padding: 6px 10px;
    background: #f7f7f7;
    border-radius: 8px;
    color: #444;
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .home-page {
      width: 94%;
      margin: 20px auto;
      padding: 18px;
    }

    .home-image { height: 220px; }
  } 
  .site-page {
  margin: 0;
  padding: 0;
  min-height: 100vh;
  font-family: "Poppins", sans-serif;
  background: #f7f7f7;
  color: #222;
}

.site-head {
  display: block;
}

.charset-meta,
.viewport-meta {
  display: block;
}

.page-title {
  font-family: "Poppins", sans-serif;
}

.google-fonts {
  display: none;
}
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  padding: 14px 32px;
  background-color: #1f2937;
  color: #ffffff;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  position: sticky;
  top: 0;
  z-index: 100;
}
 
/* ===== Logo ===== */
.navbar__logo {
  font-size: 24px;
  font-weight: 700;
  letter-spacing: 0.5px;
  color: #fbbf24;
}
 
/* ===== Links list ===== */
.navbar__links {
  display: flex;
  align-items: center;
  gap: 24px;
  list-style: none;
  margin: 0;
  padding: 0;
}
 
.navbar__item {
  margin: 0;
}
 
/* ===== Single link ===== */
.navbar__link {
  color: #e5e7eb;
  text-decoration: none;
  font-size: 16px;
  font-weight: 500;
  padding: 6px 4px;
  border-bottom: 2px solid transparent;
  transition: color 0.2s ease, border-color 0.2s ease;
}
 
.navbar__link:hover,
.navbar__link:focus {
  color: #fbbf24;
  border-bottom-color: #fbbf24;
}
 
/* ===== Mobile ===== */
@media (max-width: 640px) {
  .navbar {
    flex-direction: column;
    align-items: flex-start;
    padding: 12px 16px;
  }
 
  .navbar__links {
    flex-wrap: wrap;
    gap: 12px 16px;
  }
}
 
</style>
  <body>
    <%- include('../partials/Header') %>
    <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-6xl">
      <h2 class="text-3xl text-red-500 font-bold text-center mb-6">
        Your Favorites Homes :
      </h2>
      <div class="flex flex-wrap justify-center gap-6">
        <% filteredHome.forEach( (home) => { %>
            <div class="home-card">
            <img src="<%= home.photo %>" alt="<%= home.houseName %>" class="home-image">
            <div class="home-content">
              <h3 class="home-name"><%= home.houseName %></h3>
              <p class="home-location"><i class="fas fa-map-marker-alt mr-2"></i><%= home.location %></p>
              <div class="home-details">
                <span class="home-price">Rs<%= home.price %> / night</span>
                <div class="home-rating">
                  <!-- <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-yellow-400 mr-1">
                    <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
                  </svg> -->
                  <span ><%= home.rating %></span>
                </div>
          </div>
              <form action="/remove-fav" method="POST">
                <button type="submit" class="bg-green-300 p-2">Remove</button>
                <input type="hidden" name="homeId" value= "<%= home._id %>" >
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    </main>
  </body>
</html>
