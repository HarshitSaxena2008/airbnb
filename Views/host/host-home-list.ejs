<%- include('../partials/nav') %>
<% const homes = locals.registeredHomes || []; %>
    <style>
      /* ===== Page ===== */
      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background-color: #f3f4f6;
        color: #1f2937;
      }

      /* ===== Navbar (Header partial) ===== */
      .navbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 14px 32px;
        background-color: #1f2937;
        color: #ffffff;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
        position: sticky;
        top: 0;
        z-index: 100;
      }
      .navbar__logo {
        font-size: 24px;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: #fbbf24;
      }
      .navbar__links {
        display: flex;
        align-items: center;
        gap: 24px;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .navbar__item {
        margin: 0;
      }
      .navbar__link {
        color: #e5e7eb;
        text-decoration: none;
        font-size: 16px;
        font-weight: 500;
        padding: 6px 4px;
        border-bottom: 2px solid transparent;
        transition: color 0.2s ease, border-color 0.2s ease;
      }
      .navbar__link:hover,
      .navbar__link:focus {
        color: #fbbf24;
        border-bottom-color: #fbbf24;
      }

      /* ===== Main container ===== */
      .page-container {
        width: 100%;
        max-width: 1152px;
        margin: 40px auto 0;
        padding: 32px;
        background-color: #ffffff;
        border-radius: 8px;
        box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1), 0 4px 6px rgba(0, 0, 0, 0.05);
        box-sizing: border-box;
      }
      .page-title {
        margin: 0 0 24px;
        font-size: 30px;
        font-weight: 700;
        text-align: center;
        color: #ef4444;
      }

      /* ===== Cards grid ===== */
      .home-list {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 24px;
      }
      .home-card {
        width: 100%;
        max-width: 384px;
        background-color: #ffffff;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        transition: box-shadow 0.3s ease;
      }
      .home-card:hover {
        box-shadow: 0 10px 15px rgba(0, 0, 0, 0.15);
      }
      .home-card__image {
        display: block;
        width: 100%;
        height: 192px;
        object-fit: cover;
      }
      .home-card__body {
        padding: 16px;
      }
      .home-card__name {
        margin: 0 0 8px;
        font-size: 20px;
        font-weight: 600;
        color: #1f2937;
      }
      .home-card__location {
        margin: 0 0 8px;
        color: #4b5563;
      }
      .home-card__location i {
        margin-right: 8px;
      }
      .home-card__row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
      }
      .home-card__price {
        font-size: 18px;
        font-weight: 700;
        color: #ef4444;
      }
      .home-card__rating {
        color: #374151;
      }

      /* ===== Buttons ===== */
      .home-card__actions {
        display: flex;
        gap: 8px;
        margin-top: 8px;
      }
      .btn {
        display: inline-block;
        padding: 8px 14px;
        font-size: 14px;
        font-weight: 600;
        color: #1f2937;
        text-decoration: none;
        background-color: #86efac;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.2s ease;
      }
      .btn:hover {
        background-color: #4ade80;
      }

      /* ===== Empty state ===== */
      .empty-message {
        text-align: center;
        color: #6b7280;
      }

      /* ===== Mobile ===== */
      @media (max-width: 640px) {
        .navbar {
          flex-direction: column;
          align-items: flex-start;
          padding: 12px 16px;
        }
        .navbar__links {
          flex-wrap: wrap;
          gap: 12px 16px;
        }
        .page-container {
          margin-top: 20px;
          padding: 20px 16px;
        }
        .page-title {
          font-size: 24px;
        }
      }
    </style>
  </head>
  <body>
    <%- include('../partials/Header') %>
    <main class="page-container">
      <h2 class="page-title">
        Welcome to airbnb Host page:
      </h2>
      <div class="home-list">
        <% if (homes.length === 0) { %>
          <p class="empty-message">No homes added yet.</p>
        <% } %>
        <% homes.forEach(home => { %>
          <div class="home-card">
            <img class="home-card__image" src="<%= home.photo %>" alt="<%= home.houseName %>">
            <div class="home-card__body">
              <h3 class="home-card__name"><%= home.houseName %></h3>
              <p class="home-card__location"><i class="fas fa-map-marker-alt"></i><%= home.location %></p>
              <div class="home-card__row">
                <span class="home-card__price">Rs<%= home.price %> / night</span>
                <span class="home-card__rating"><%= home.rating %></span>
              </div>
              <div class="home-card__actions">
                <a class="btn" href="/host/host-home-list/edit/<%= home ? home._id : '' %>?editing=true">Edit</a>
                <a class="btn" href="/host/host-home-list/delete/<%= home ? home._id : '' %>">Delete</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </main>
  </body>
</html>
